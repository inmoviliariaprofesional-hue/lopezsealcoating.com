---
import Base from "../layouts/Base.astro";
import Landing from "../components/Landing.astro";
import { buildCopy } from "../lib/content";

// Textos fijos de src/i18n con lo editado en /admin encima.
const t = buildCopy("en", Astro.locals.content);
---

<Base lang={t.htmlLang} title={t.metaTitle} description={t.metaDescription}>
  <Landing t={t} />
</Base>
