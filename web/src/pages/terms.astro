---
import ServiceLayout from "../layouts/ServiceLayout.astro";
import { site } from "../data/site";

const title = "Terms of Use | Lopez Sealcoating LLC";
const description = "The terms that govern your use of the Lopez Sealcoating LLC website.";
const updated = new Date().toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<ServiceLayout
  lang="en"
  title={title}
  description={description}
  enHref="/terms"
  esHref="/es/terminos"
  showCta={false}
>
  <article class="mx-auto max-w-3xl px-4 py-16 text-asphalt/75 sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-extrabold leading-tight text-asphalt sm:text-5xl">Terms of Use</h1>
    <p class="mt-3 text-sm text-asphalt/55">Last updated: {updated}</p>

    <p class="mt-6 leading-7">
      These Terms of Use govern your access to and use of <b>lopezsealcoating.com</b>, operated by
      <b>Lopez Sealcoating LLC</b>. By using this website, you agree to these terms.
    </p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Our services</h2>
    <p class="mt-4 leading-7">
      This website is for general information. Estimates are free and are <b>not a binding contract</b> until agreed in
      writing. Scheduling and completion of work depend on weather, season (May–October), and availability.
    </p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Use of the website</h2>
    <p class="mt-4 leading-7">You agree to use this website lawfully and not to misuse it or interfere with its normal operation.</p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Intellectual property</h2>
    <p class="mt-4 leading-7">
      The content, logo, text, and images on this site belong to Lopez Sealcoating LLC or its licensors and may not be
      used without permission.
    </p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">No warranties</h2>
    <p class="mt-4 leading-7">The website is provided "as is" without warranties of any kind. We aim for accuracy but do not guarantee the site is error-free or always available.</p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Limitation of liability</h2>
    <p class="mt-4 leading-7">To the extent permitted by law, Lopez Sealcoating LLC is not liable for any indirect or incidental damages arising from your use of this website.</p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Third-party links</h2>
    <p class="mt-4 leading-7">Our site may link to third-party sites (such as Facebook or Google). We are not responsible for their content or practices.</p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Governing law</h2>
    <p class="mt-4 leading-7">These terms are governed by the laws of the State of Illinois, USA.</p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Changes</h2>
    <p class="mt-4 leading-7">We may update these terms at any time. The latest version will be posted on this page.</p>

    <h2 class="mt-10 font-display text-2xl font-extrabold text-asphalt">Contact us</h2>
    <p class="mt-4 leading-7">
      Lopez Sealcoating LLC<br />
      5601 Court Leona, Hanover Park, IL 60133<br />
      <a class="font-semibold text-asphalt underline" href={`mailto:${site.email}`}>{site.email}</a> · {site.phoneDisplay}
    </p>
  </article>
</ServiceLayout>
