<!-- ===== Mobile action bar ===== -->
<div class="mobile-action-bar fixed inset-x-0 bottom-0 z-50 border-t border-black/10 bg-white/95 p-2 shadow-[0_-12px_36px_rgba(0,0,0,.12)] backdrop-blur-xl md:hidden">
  <div class="grid grid-cols-[.75fr_1.25fr_.7fr] gap-2">
    <a href={telHref} class="focus-ring flex min-h-12 items-center justify-center rounded-xl border border-black/8 text-xs font-extrabold text-asphalt">{t.cta.call}</a>
    <a href="#contact" class="focus-ring flex min-h-12 items-center justify-center rounded-xl bg-signal px-3 text-center text-xs font-extrabold text-asphalt">{t.cta.quote}</a>
    <a href={t.langSwitchHref}
        data-language-switch aria-label={t.language.aria} class="focus-ring flex min-h-12 items-center justify-center gap-1 rounded-xl bg-asphalt text-xs font-extrabold text-white"><span class="text-signal">◎</span>{t.language.badge}</a>
  </div>
</div>

<script>
  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status") as HTMLParagraphElement | null;
  const draftKey = "lopez-sealcoating-quote-draft";

  const getVisibleSectionHash = () => {
    const marker = window.innerHeight * 0.35;
    const sections = Array.from(document.querySelectorAll<HTMLElement>("main section[id]"));

    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      if (rect.top <= marker && rect.bottom >= marker) return `#${section.id}`;
    }

    let hash = "#top";
    let largestVisibleArea = 0;
    for (const section of sections) {
      const rect = section.getBoundingClientRect();
      const visibleArea = Math.max(0, Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0));
      if (visibleArea > largestVisibleArea) {
        largestVisibleArea = visibleArea;
        hash = `#${section.id}`;
      }
    }

    return hash;
  };

  // Cambiar de idioma conserva la sección visible y cualquier borrador del formulario.
  document.querySelectorAll<HTMLAnchorElement>("[data-language-switch]").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const target = new URL(link.href, window.location.href);
      target.hash = getVisibleSectionHash();

      if (form) {
        const draft: Record<string, string> = {};
        for (const [key, value] of new FormData(form).entries()) {
          if (key !== "company" && key !== "lang" && typeof value === "string" && value.trim()) {
            draft[key] = value;
          }
        }
        if (Object.keys(draft).length) sessionStorage.setItem(draftKey, JSON.stringify(draft));
      }

      window.location.assign(target.href);
    });
  });

  if (form) {
    try {
      const saved = sessionStorage.getItem(draftKey);
      if (saved) {
        const draft = JSON.parse(saved) as Record<string, string>;
        for (const [name, value] of Object.entries(draft)) {
          const field = form.elements.namedItem(name);
          if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
            field.value = value;
          }
        }
        sessionStorage.removeItem(draftKey);
      }
    } catch {
      sessionStorage.removeItem(draftKey);
    }
  }

  if (form && status) {
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    const originalBtnText = btn?.textContent ?? "";

    const setStatus = (msg: string, kind: "ok" | "err" | "info") => {
      status.textContent = msg;
      status.classList.remove("hidden", "text-green-700", "text-red-600", "text-asphalt");
      status.classList.add(kind === "ok" ? "text-green-700" : kind === "err" ? "text-red-600" : "text-asphalt");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());

      if (data.company) {
        setStatus(form.dataset.success || "", "ok");
        form.reset();
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = form.dataset.sending || "…";
      }
      setStatus(form.dataset.sending || "", "info");

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!response.ok) throw new Error("bad status " + response.status);
        setStatus(form.dataset.success || "", "ok");
        form.reset();
      } catch {
        setStatus(form.dataset.error || "", "err");
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = originalBtnText;
        }
      }
    });
  }
</script>
