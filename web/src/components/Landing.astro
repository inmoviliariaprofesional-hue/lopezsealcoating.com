      <div>
        <div class="flex items-center gap-3">
          <span class="relative grid h-10 w-10 place-items-center overflow-hidden rounded-xl bg-signal"><span class="absolute h-16 w-[5px] rotate-[38deg] bg-asphalt"></span><span class="relative text-[10px] font-black text-asphalt">LS</span></span>
          <span class="font-display text-base font-extrabold text-white">LOPEZ <span class="text-signal">SEALCOATING</span> <span class="font-semibold text-white/45">LLC</span></span>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-6">{t.footer.tagline}</p>
        <p class="mt-2 text-xs text-white/60">{t.footer.season}</p>
      </div>
      <div class="space-y-3 text-sm">
        <a href={telHref} class="focus-ring block rounded hover:text-signal">{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`} class="focus-ring block break-all rounded hover:text-signal">{site.email}</a>
        <a href={waHref} target="_blank" rel="noopener" class="focus-ring block rounded hover:text-signal">WhatsApp</a>
      </div>
      <div class="rounded-2xl border border-signal/22 bg-signal/[.06] p-5">
        <p class="text-xs font-semibold leading-5 text-white/70">{t.language.footerPrompt}</p>
        <a href={t.langSwitchHref}
        data-language-switch class="focus-ring mt-4 inline-flex items-center gap-2 rounded-full bg-signal px-4 py-2.5 text-xs font-extrabold text-asphalt">
          <span aria-hidden="true">◎</span> {t.language.action}
        </a>
      </div>
    </div>
    <div class="flex flex-col gap-2 pt-7 text-[11px] text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {site.legalName}. {t.footer.rights}</p>
      <p>Chicagoland Area, Illinois</p>
