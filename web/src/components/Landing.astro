---
import { site } from "../data/site";
import type { Copy } from "../i18n";

interface Props {
  t: Copy;
}
const { t } = Astro.props;

const telHref = `tel:${site.phoneE164}`;
const waHref = `https://wa.me/${site.whatsapp}`;
---

<!-- ===== Header ===== -->
<header class="sticky top-0 z-50 bg-asphalt/95 backdrop-blur border-b border-signal/30">
  <div class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-2 shrink-0">
      <span class="inline-block h-7 w-7 rounded signal-stripes"></span>
      <span class="font-extrabold tracking-tight text-white text-lg leading-none">
        LOPEZ <span class="text-signal">SEALCOATING</span>
      </span>
    </a>
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-white/80">
      <a href="#services" class="hover:text-signal transition">{t.nav.services}</a>
      <a href="#work" class="hover:text-signal transition">{t.nav.work}</a>
      <a href="#area" class="hover:text-signal transition">{t.nav.area}</a>
      <a href="#reviews" class="hover:text-signal transition">{t.nav.reviews}</a>
    </nav>
    <div class="flex items-center gap-3">
      <a
        href={t.langSwitchHref}
        class="text-xs font-semibold text-white/70 hover:text-signal border border-white/20 rounded-full px-3 py-1 transition"
        >{t.langSwitchLabel}</a
      >
      <a
        href={telHref}
        class="hidden sm:inline-flex items-center gap-2 bg-signal text-asphalt font-bold text-sm px-4 py-2 rounded-full hover:bg-signal-600 transition"
      >
        📞 {site.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<main id="top">
  <!-- ===== Hero ===== -->
  <section class="relative bg-asphalt text-white overflow-hidden">
    <div class="absolute inset-0 opacity-[0.06] signal-stripes"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28">
      <p class="text-signal font-semibold tracking-wide uppercase text-sm mb-4">
        {t.hero.eyebrow}
      </p>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-[1.05] max-w-3xl">
        {t.hero.title}
      </h1>
      <p class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl">
        {t.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 bg-signal text-asphalt font-bold px-6 py-3 rounded-full hover:bg-signal-600 transition"
        >
          {t.cta.quote}
        </a>
        <a
          href={telHref}
          class="inline-flex items-center gap-2 border-2 border-white/30 text-white font-bold px-6 py-3 rounded-full hover:border-signal hover:text-signal transition"
        >
          📞 {t.cta.call}
        </a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/70">
        {t.hero.bullets.map((b) => (
          <li class="flex items-center gap-2">
            <span class="text-signal font-bold">✓</span>
            {b}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ===== Trust bar ===== -->
  <section class="bg-signal text-asphalt">
    <div class="mx-auto max-w-6xl px-4 py-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-sm font-bold">
      <span>✔ {t.trust.free}</span>
      <span>✔ {t.trust.spanish}</span>
      <span>✔ {t.trust.local}</span>
      {site.insured && <span>✔ {t.trust.insured}</span>}
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section id="services" class="py-20">
    <div class="mx-auto max-w-6xl px-4">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-extrabold">{t.services.title}</h2>
        <p class="mt-3 text-asphalt-700/70 text-lg">{t.services.subtitle}</p>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {t.services.items.map((item) => (
          <article class="rounded-2xl border border-black/10 p-7 hover:shadow-lg hover:border-signal transition">
            <div class="h-12 w-12 rounded-xl signal-stripes mb-5"></div>
            <h3 class="text-xl font-bold">{item.name}</h3>
            <p class="mt-3 text-asphalt-700/70 leading-relaxed">{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Work / Gallery ===== -->
  <section id="work" class="py-20 bg-neutral-50">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-3xl md:text-4xl font-extrabold">{t.work.title}</h2>
      <p class="mt-3 text-asphalt-700/70 text-lg">{t.work.subtitle}</p>
      <div class="mt-10 grid gap-4 grid-cols-2 md:grid-cols-4">
        {Array.from({ length: 8 }).map((_, i) => (
          <div class="aspect-square rounded-xl bg-asphalt/5 border border-black/5 flex items-center justify-center text-asphalt-700/30 text-sm">
            {`Foto ${i + 1}`}
          </div>
        ))}
      </div>
      <p class="mt-4 text-sm text-asphalt-700/50 italic">{t.work.note}</p>
    </div>
  </section>

  <!-- ===== Service area ===== -->
  <section id="area" class="py-20">
    <div class="mx-auto max-w-6xl px-4 grid md:grid-cols-2 gap-10 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-extrabold">{t.area.title}</h2>
        <p class="mt-4 text-lg text-asphalt-700/70">{t.area.body}</p>
        <p class="mt-3 text-asphalt-700/60">{t.area.note}</p>
        <a
          href={telHref}
          class="mt-6 inline-flex items-center gap-2 bg-asphalt text-white font-bold px-6 py-3 rounded-full hover:bg-asphalt-700 transition"
        >
          📞 {site.phoneDisplay}
        </a>
      </div>
      <div class="rounded-2xl bg-asphalt text-white p-10 text-center">
        <div class="text-6xl font-extrabold text-signal">{site.serviceRadiusMiles}<span class="text-2xl align-top"> mi</span></div>
        <p class="mt-2 text-white/70">Chicagoland</p>
      </div>
    </div>
  </section>

  <!-- ===== Reviews ===== -->
  <section id="reviews" class="py-20 bg-asphalt text-white">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <div class="text-signal text-3xl tracking-widest">★★★★★</div>
      <h2 class="mt-4 text-3xl md:text-4xl font-extrabold">{t.reviews.title}</h2>
      <p class="mt-4 text-white/75 text-lg">{t.reviews.body}</p>
      {site.googleProfileUrl && (
        <a
          href={site.googleProfileUrl}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 bg-signal text-asphalt font-bold px-6 py-3 rounded-full hover:bg-signal-600 transition"
        >
          {t.reviews.button}
        </a>
      )}
    </div>
  </section>

  <!-- ===== Contact / Free estimate ===== -->
  <section id="contact" class="py-20">
    <div class="mx-auto max-w-3xl px-4">
      <div class="text-center max-w-xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-extrabold">{t.contact.title}</h2>
        <p class="mt-3 text-asphalt-700/70 text-lg">{t.contact.subtitle}</p>
      </div>

      <form
        id="quote-form"
        class="mt-10 grid gap-4"
        method="POST"
        action="/api/quote"
        data-sending={t.contact.sending}
        data-success={t.contact.success}
        data-error={t.contact.error}
      >
        <input type="hidden" name="lang" value={t.htmlLang} />
        {/* Honeypot anti-spam: los bots lo llenan, las personas no lo ven */}
        <input
          type="text"
          name="company"
          tabindex="-1"
          autocomplete="off"
          class="hidden"
          aria-hidden="true"
        />
        <div class="grid md:grid-cols-2 gap-4">
          <input
            required
            name="name"
            placeholder={t.contact.name}
            class="rounded-xl border border-black/15 px-4 py-3 focus:outline-none focus:border-signal focus:ring-2 focus:ring-signal/40"
          />
          <input
            required
            type="tel"
            name="phone"
            placeholder={t.contact.phone}
            class="rounded-xl border border-black/15 px-4 py-3 focus:outline-none focus:border-signal focus:ring-2 focus:ring-signal/40"
          />
        </div>
        <input
          type="email"
          name="email"
          placeholder={t.contact.email}
          class="rounded-xl border border-black/15 px-4 py-3 focus:outline-none focus:border-signal focus:ring-2 focus:ring-signal/40"
        />
        <select
          name="service"
          class="rounded-xl border border-black/15 px-4 py-3 bg-white focus:outline-none focus:border-signal focus:ring-2 focus:ring-signal/40"
        >
          {t.contact.serviceOptions.map((o) => <option>{o}</option>)}
        </select>
        <textarea
          name="message"
          rows="4"
          placeholder={t.contact.message}
          class="rounded-xl border border-black/15 px-4 py-3 focus:outline-none focus:border-signal focus:ring-2 focus:ring-signal/40"
        ></textarea>
        <button
          type="submit"
          class="bg-signal text-asphalt font-bold px-6 py-4 rounded-full hover:bg-signal-600 transition disabled:opacity-60 disabled:cursor-not-allowed"
        >
          {t.contact.send}
        </button>
        <p id="form-status" class="text-sm text-center font-medium hidden" role="status" aria-live="polite"></p>
        <p class="text-xs text-asphalt-700/50 text-center">{t.contact.disclaimer}</p>
      </form>

      <div class="mt-10 text-center">
        <p class="text-sm text-asphalt-700/60 mb-4">{t.contact.or}</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={telHref}
            class="inline-flex items-center gap-2 border-2 border-asphalt/20 font-bold px-6 py-3 rounded-full hover:border-signal transition"
          >
            📞 {site.phoneDisplay}
          </a>
          <a
            href={waHref}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-[#25D366] text-white font-bold px-6 py-3 rounded-full hover:opacity-90 transition"
          >
            💬 {t.cta.whatsapp}
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- ===== Footer ===== -->
<footer class="bg-asphalt text-white/70">
  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-8 md:grid-cols-3">
    <div>
      <span class="font-extrabold text-white text-lg">
        LOPEZ <span class="text-signal">SEALCOATING</span>
      </span>
      <p class="mt-3 text-sm">{t.footer.tagline}</p>
      <p class="mt-1 text-sm">{t.footer.season}</p>
    </div>
    <div class="text-sm space-y-2">
      <a href={telHref} class="block hover:text-signal">📞 {site.phoneDisplay}</a>
      <a href={`mailto:${site.email}`} class="block hover:text-signal break-all">✉ {site.email}</a>
      <a href={waHref} target="_blank" rel="noopener" class="block hover:text-signal">💬 WhatsApp</a>
    </div>
    <div class="text-sm md:text-right">
      <p class="text-white/50">
        © {new Date().getFullYear()} {site.legalName}.<br />{t.footer.rights}
      </p>
    </div>
  </div>
</footer>


<script>
  const form = document.getElementById("quote-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status") as HTMLParagraphElement | null;

  if (form && status) {
    const btn = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    const originalBtnText = btn?.textContent ?? "";

    const setStatus = (msg: string, kind: "ok" | "err" | "info") => {
      status.textContent = msg;
      status.classList.remove("hidden", "text-green-700", "text-red-600", "text-asphalt");
      status.classList.add(
        kind === "ok" ? "text-green-700" : kind === "err" ? "text-red-600" : "text-asphalt"
      );
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());

      // Honeypot: si viene lleno, es un bot -> fingimos éxito y no enviamos.
      if (data.company) {
        setStatus(form.dataset.success || "", "ok");
        form.reset();
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.textContent = form.dataset.sending || "…";
      }
      setStatus(form.dataset.sending || "", "info");

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error("bad status " + res.status);
        setStatus(form.dataset.success || "", "ok");
        form.reset();
      } catch (err) {
        setStatus(form.dataset.error || "", "err");
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.textContent = originalBtnText;
        }
      }
    });
  }
</script>
