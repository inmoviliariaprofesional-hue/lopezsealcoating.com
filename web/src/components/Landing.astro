---
import { site } from "../data/site";
import type { Copy } from "../i18n";

interface Props {
  t: Copy;
}
const { t } = Astro.props;

const telHref = `tel:${site.phoneE164}`;
const waHref = `https://wa.me/${site.whatsapp}`;
// Imágenes ilustrativas (stock CC0) para la galería de referencia.
const workImages = [
  "/images/work-1.jpg",
  "/images/work-2.jpg",
  "/images/work-3.jpg",
  "/images/work-4.jpg",
  "/images/work-5.jpg",
  "/images/work-6.jpg",
];
---

<!-- ===== Header ===== -->
<header class="sticky top-0 z-50 border-b border-white/10 bg-asphalt-950/95 text-white backdrop-blur-xl">
  <div class="mx-auto flex h-[76px] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="#top" class="focus-ring flex min-w-0 items-center gap-3 rounded-lg" aria-label="Lopez Sealcoating">
      <span class="relative grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-xl bg-signal shadow-[0_0_30px_rgba(248,201,0,.16)]">
        <span class="absolute h-16 w-[6px] rotate-[38deg] bg-asphalt"></span>
        <span class="absolute h-16 w-[2px] rotate-[38deg] bg-signal-500"></span>
        <span class="relative text-[11px] font-black tracking-[-.08em] text-asphalt">LS</span>
      </span>
      <span class="truncate font-display text-sm font-extrabold tracking-[-.03em] sm:text-base">
        LOPEZ <span class="text-signal">SEALCOATING</span> <span class="font-semibold text-white/45">LLC</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-[13px] font-semibold text-white/65 lg:flex" aria-label={t.navAria}>
      <a href="#services" class="focus-ring rounded hover:text-white">{t.nav.services}</a>
      <a href="#process" class="focus-ring rounded hover:text-white">{t.nav.process}</a>
      <a href="#work" class="focus-ring rounded hover:text-white">{t.nav.work}</a>
      <a href="#area" class="focus-ring rounded hover:text-white">{t.nav.area}</a>
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={t.langSwitchHref}
        data-language-switch
        aria-label={t.language.aria}
        class="focus-ring group inline-flex items-center gap-2 rounded-full border border-signal/55 bg-signal/10 px-3 py-2 text-xs font-extrabold text-signal transition hover:bg-signal hover:text-asphalt sm:px-4"
      >
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.3 3 14.7 0 18M12 3c-3 3.3-3 14.7 0 18"></path>
        </svg>
        <span class="hidden sm:inline">{t.langSwitchLabel}</span>
        <span class="sm:hidden">{t.language.badge}</span>
      </a>
      <a
        href={telHref}
        class="focus-ring hidden items-center gap-2 rounded-full bg-signal px-4 py-2.5 text-xs font-extrabold text-asphalt shadow-[0_8px_24px_rgba(248,201,0,.2)] transition hover:bg-signal-500 md:inline-flex"
      >
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path>
        </svg>
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</header>

<main id="top" class="mobile-page-offset">
  <!-- ===== Hero ===== -->
  <section class="asphalt-texture relative isolate overflow-hidden text-white">
    <div class="road-grid absolute inset-0 opacity-60"></div>
    <div class="absolute -left-40 top-20 h-[420px] w-[420px] rounded-full bg-signal/10 blur-[110px]"></div>
    <div class="absolute -right-24 -top-20 h-[520px] w-[520px] rounded-full border border-white/5"></div>
    <div class="absolute -right-10 top-8 h-[380px] w-[380px] rounded-full border border-white/5"></div>

    <div class="relative mx-auto grid min-h-[690px] max-w-7xl items-center gap-14 px-4 py-16 sm:px-6 md:py-20 lg:grid-cols-[1.08fr_.92fr] lg:px-8 lg:py-24">
      <div>
        <div class="mb-7 flex flex-wrap items-center gap-3">
          <span class="rounded-full border border-signal/30 bg-signal/10 px-3 py-1.5 text-[11px] font-extrabold uppercase tracking-[.18em] text-signal">
            {t.hero.eyebrow}
          </span>
          <a href={t.langSwitchHref}
        data-language-switch class="focus-ring inline-flex items-center gap-2 rounded-full px-1 py-1 text-xs font-bold text-white/65 hover:text-white">
            <span class="grid h-6 w-6 place-items-center rounded-full bg-white/10 text-[10px] text-signal">{t.language.badge}</span>
            {t.language.prompt} <span aria-hidden="true">→</span>
          </a>
        </div>

        <h1 class="max-w-4xl font-display text-[clamp(2.85rem,7vw,5.75rem)] font-extrabold leading-[.96] tracking-[-.06em]">
          {t.hero.title}<br />
          <span class="text-signal">{t.hero.accent}</span>
        </h1>
        <p class="mt-7 max-w-2xl text-base leading-7 text-white/66 sm:text-lg sm:leading-8">
          {t.hero.subtitle}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="#contact"
            class="focus-ring inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-signal px-7 text-sm font-extrabold text-asphalt shadow-[0_14px_40px_rgba(248,201,0,.18)] transition hover:-translate-y-0.5 hover:bg-signal-500"
          >
            {t.cta.quote}
            <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"></path></svg>
          </a>
          <a
            href={telHref}
            class="focus-ring inline-flex min-h-14 items-center justify-center gap-3 rounded-full border border-white/18 bg-white/[.06] px-7 text-sm font-extrabold text-white transition hover:border-white/35 hover:bg-white/10"
          >
            <svg aria-hidden="true" class="h-4 w-4 text-signal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>
            {t.cta.call}
          </a>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-xs font-semibold text-white/70 sm:text-sm">
          {t.hero.bullets.map((bullet) => (
            <li class="flex items-center gap-2">
              <span class="grid h-5 w-5 place-items-center rounded-full border border-signal/35 bg-signal/10 text-[10px] font-black text-signal">✓</span>
              {bullet}
            </li>
          ))}
        </ul>
      </div>

      <!-- Visual de marca: asfalto + señalización, sin usar el logo copiado -->
      <div class="relative mx-auto w-full max-w-[530px] lg:mx-0 lg:ml-auto">
        <div class="absolute -inset-8 rounded-[2.5rem] bg-signal/10 blur-3xl"></div>
        <div class="glass-dark relative overflow-hidden rounded-[2rem] p-3 shadow-[0_35px_100px_rgba(0,0,0,.48)]">
          <div class="asphalt-texture relative min-h-[470px] overflow-hidden rounded-[1.45rem] border border-white/8 p-7 sm:p-9">
            <img
              src="/images/hero-driveway.jpg"
              alt={t.hero.visualTitle}
              width="1100"
              height="760"
              fetchpriority="high"
              class="absolute inset-0 h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/55 to-black/25"></div>
            <div class="absolute -bottom-24 -right-20 h-72 w-72 rounded-full border-[46px] border-white/[.06]"></div>

            <div class="relative flex h-full min-h-[398px] flex-col justify-between">
              <div>
                <div class="mb-6 flex items-center justify-between">
                  <span class="text-[10px] font-extrabold uppercase tracking-[.2em] text-signal">{t.hero.visualEyebrow}</span>
                  <span class="rounded-full border border-white/10 bg-white/[.06] px-3 py-1 text-[10px] font-bold text-white/65">Chicagoland Area</span>
                </div>
                <p class="max-w-sm font-display text-3xl font-extrabold leading-tight sm:text-4xl">{t.hero.visualTitle}</p>
              </div>

              <div class="grid gap-2 sm:grid-cols-3">
                {t.hero.visualSteps.map((step, i) => (
                  <div class="rounded-2xl border border-white/10 bg-black/30 p-4 backdrop-blur">
                    <span class="mb-3 block text-[10px] font-black text-signal">0{i + 1}</span>
                    <span class="text-sm font-extrabold text-white">{step}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-3 rounded-2xl border border-black/5 bg-white px-5 py-4 text-asphalt shadow-2xl sm:-left-10">
          <span class="block text-[10px] font-extrabold uppercase tracking-[.16em] text-asphalt/65">{t.hero.visualEstimate}</span>
          <span class="mt-1 block font-display text-lg font-extrabold">{site.phoneDisplay}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Trust strip ===== -->
  <section class="relative z-10 border-y border-black/5 bg-white">
    <div class="mx-auto grid max-w-7xl grid-cols-1 divide-y divide-black/7 px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6 lg:px-8">
      {[t.trust.free, t.trust.spanish, t.trust.local].map((item, i) => (
        <div class="flex items-center justify-center gap-3 px-5 py-5 text-center text-xs font-extrabold uppercase tracking-[.1em] text-asphalt/70">
          <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-signal/15 text-xs text-asphalt">0{i + 1}</span>
          {item}
        </div>
      ))}
    </div>
  </section>

  <!-- ===== Services ===== -->
  <section id="services" class="bg-concrete py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[.2em] text-asphalt/65">{t.services.eyebrow}</p>
          <h2 class="mt-4 max-w-xl font-display text-4xl font-extrabold leading-[1.04] sm:text-5xl">{t.services.title}</h2>
        </div>
        <p class="max-w-2xl text-base leading-7 text-asphalt/65 lg:justify-self-end lg:text-lg">{t.services.subtitle}</p>
      </div>

      <div class="mt-14 grid gap-5 lg:grid-cols-3">
        {t.services.items.map((item, i) => (
          <article class={`surface-card lift relative overflow-hidden rounded-[1.75rem] border p-7 sm:p-8 ${i === 1 ? "border-signal/45 bg-asphalt text-white" : "border-black/7 bg-white text-asphalt"}`}>
            <div class="mb-16 flex items-start justify-between">
              <span class={`font-display text-sm font-extrabold ${i === 1 ? "text-signal" : "text-asphalt/65"}`}>{item.number}</span>
              <span class={`rounded-full px-3 py-1 text-[10px] font-extrabold uppercase tracking-[.13em] ${i === 1 ? "bg-signal text-asphalt" : "bg-asphalt/6 text-asphalt/65"}`}>{item.tag}</span>
            </div>
            <h3 class="font-display text-2xl font-extrabold leading-tight">{item.name}</h3>
            <p class={`mt-4 text-sm leading-6 ${i === 1 ? "text-white/60" : "text-asphalt/65"}`}>{item.desc}</p>
            <div class={`mt-8 h-1 w-12 rounded-full ${i === 1 ? "bg-signal" : "bg-asphalt"}`}></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Language invitation ===== -->
  <section class="bg-signal px-4 py-5 sm:px-6">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-4 rounded-2xl sm:flex-row sm:items-center">
      <div class="flex items-start gap-4">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-asphalt text-xs font-black text-signal">{t.language.badge}</span>
        <div>
          <p class="font-display text-lg font-extrabold text-asphalt">{t.languageBanner.title}</p>
          <p class="mt-1 text-sm text-asphalt/65">{t.languageBanner.body}</p>
        </div>
      </div>
      <a href={t.langSwitchHref}
        data-language-switch class="focus-ring inline-flex shrink-0 items-center gap-2 rounded-full bg-asphalt px-5 py-3 text-xs font-extrabold text-white transition hover:bg-asphalt-700">
        {t.languageBanner.action} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ===== Process ===== -->
  <section id="process" class="bg-white py-24 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-xs font-extrabold uppercase tracking-[.2em] text-asphalt/65">{t.process.eyebrow}</p>
        <h2 class="mt-4 font-display text-4xl font-extrabold sm:text-5xl">{t.process.title}</h2>
        <p class="mt-5 text-base leading-7 text-asphalt/65 sm:text-lg">{t.process.subtitle}</p>
      </div>
      <div class="relative mt-16 grid gap-6 md:grid-cols-3">
        <div class="absolute left-[16%] right-[16%] top-7 hidden h-px bg-black/10 md:block"></div>
        {t.process.steps.map((step) => (
          <article class="relative text-center">
            <span class="relative z-10 mx-auto grid h-14 w-14 place-items-center rounded-2xl border border-black/8 bg-concrete font-display text-sm font-extrabold text-asphalt shadow-sm">{step.number}</span>
            <h3 class="mt-7 font-display text-xl font-extrabold">{step.name}</h3>
            <p class="mx-auto mt-3 max-w-xs text-sm leading-6 text-asphalt/65">{step.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Work / editorial placeholders ===== -->
  <section id="work" class="asphalt-texture relative overflow-hidden py-24 text-white sm:py-28">
    <div class="road-grid absolute inset-0 opacity-40"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[.2em] text-signal">{t.work.eyebrow}</p>
          <h2 class="mt-4 max-w-2xl font-display text-4xl font-extrabold leading-[1.05] sm:text-5xl">{t.work.title}</h2>
        </div>
        <p class="max-w-xl text-base leading-7 text-white/65 lg:justify-self-end">{t.work.subtitle}</p>
      </div>

      <div class="mt-14 grid grid-cols-2 gap-4 sm:grid-cols-3">
        {workImages.map((src, i) => (
          <figure class="group relative aspect-[3/4] overflow-hidden rounded-[1.5rem] border border-white/10">
            <img
              src={src}
              alt={t.work.labels[i]}
              width="900"
              height="1200"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>
            <figcaption class="absolute bottom-0 left-0 p-4">
              <span class="rounded-full bg-signal px-3 py-1 text-[10px] font-extrabold uppercase tracking-[.14em] text-asphalt">
                {t.work.labels[i]}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
      {t.work.note && <p class="mt-5 text-xs italic text-white/60">{t.work.note}</p>}
    </div>
  </section>

  <!-- ===== Service area ===== -->
  <section id="area" class="bg-concrete py-24 sm:py-28">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_.92fr] lg:items-center lg:px-8">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[.2em] text-asphalt/65">{t.area.eyebrow}</p>
        <h2 class="mt-4 max-w-2xl font-display text-4xl font-extrabold leading-[1.04] sm:text-5xl">{t.area.title}</h2>
        <p class="mt-6 max-w-xl text-base leading-7 text-asphalt/65 sm:text-lg">{t.area.body}</p>
        <p class="mt-4 text-sm font-semibold text-asphalt/65">{t.area.note}</p>
        <a href={telHref} class="focus-ring mt-8 inline-flex items-center gap-3 rounded-full bg-asphalt px-6 py-3.5 text-sm font-extrabold text-white transition hover:bg-asphalt-700">
          <svg aria-hidden="true" class="h-4 w-4 text-signal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"></path></svg>
          {site.phoneDisplay}
        </a>
      </div>

      <div class="surface-card overflow-hidden rounded-[2rem] border border-black/7 bg-white">
        <div class="asphalt-texture relative overflow-hidden p-8 text-white sm:p-10">
          <img
            src="/images/asphalt-lane.jpg"
            alt=""
            aria-hidden="true"
            width="1600"
            height="900"
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover opacity-30"
          />
          <div class="absolute inset-0 bg-asphalt/55"></div>
          <div class="relative">
            <span class="font-display text-[clamp(4.5rem,13vw,7.5rem)] font-extrabold leading-none text-signal">{site.serviceRadiusMiles}</span>
            <span class="ml-2 font-display text-2xl font-extrabold">mi</span>
            <p class="mt-3 text-sm text-white/75">{t.area.radiusLabel}</p>
          </div>
        </div>
        <div class="p-7 sm:p-9">
          <p class="text-[10px] font-extrabold uppercase tracking-[.18em] text-asphalt/65">{t.area.coverageLabel}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {t.area.coverageTypes.map((item) => (
              <span class="rounded-full border border-black/8 bg-concrete px-3 py-2 text-xs font-bold text-asphalt/70">{item}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Reviews ===== -->
  <section id="reviews" class="bg-white py-24 sm:py-28">
    <div class="mx-auto max-w-5xl px-4 text-center sm:px-6 lg:px-8">
      <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-signal text-2xl text-asphalt" aria-hidden="true">☆</span>
      <p class="mt-6 text-xs font-extrabold uppercase tracking-[.2em] text-asphalt/65">{t.reviews.eyebrow}</p>
      <h2 class="mx-auto mt-4 max-w-3xl font-display text-4xl font-extrabold leading-[1.06] sm:text-5xl">{t.reviews.title}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-asphalt/65">{t.reviews.body}</p>
      {site.googleProfileUrl ? (
        <a href={site.googleProfileUrl} target="_blank" rel="noopener" class="focus-ring mt-8 inline-flex items-center gap-2 rounded-full bg-asphalt px-6 py-3.5 text-sm font-extrabold text-white hover:bg-asphalt-700">
          {t.reviews.button} <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="mt-8 inline-flex items-center gap-2 rounded-full border border-black/8 bg-concrete px-5 py-3 text-xs font-extrabold text-asphalt/65">
          <span class="h-2 w-2 rounded-full bg-signal"></span>{t.reviews.pending}
        </span>
      )}
    </div>
  </section>

  <!-- ===== Contact ===== -->
  <section id="contact" class="bg-concrete py-24 sm:py-28">
    <div class="mx-auto grid max-w-7xl overflow-hidden rounded-[2rem] border border-black/7 bg-white shadow-[0_35px_100px_rgba(10,10,10,.10)] lg:grid-cols-[.8fr_1.2fr]">
      <div class="asphalt-texture relative overflow-hidden p-8 text-white sm:p-12">
        <div class="road-grid absolute inset-0 opacity-40"></div>
        <div class="relative flex h-full flex-col">
          <p class="text-xs font-extrabold uppercase tracking-[.2em] text-signal">{t.contact.eyebrow}</p>
          <h2 class="mt-5 font-display text-4xl font-extrabold leading-[1.05]">{t.contact.title}</h2>
          <p class="mt-5 text-sm leading-6 text-white/65">{t.contact.subtitle}</p>

          <div class="mt-12 rounded-2xl border border-white/10 bg-white/[.05] p-6">
            <p class="font-display text-xl font-extrabold">{t.contact.directTitle}</p>
            <p class="mt-2 text-sm leading-6 text-white/65">{t.contact.directBody}</p>
            <div class="mt-6 space-y-3">
              <a href={telHref} class="focus-ring flex items-center gap-3 rounded-xl bg-signal px-4 py-3 text-sm font-extrabold text-asphalt">
                <span aria-hidden="true">☎</span> {site.phoneDisplay}
              </a>
              <a href={waHref} target="_blank" rel="noopener" class="focus-ring flex items-center gap-3 rounded-xl border border-white/12 px-4 py-3 text-sm font-extrabold text-white hover:bg-white/8">
                <span aria-hidden="true">◉</span> {t.cta.whatsapp}
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="p-7 sm:p-10 lg:p-12">
        <form
          id="quote-form"
          class="grid gap-4"
          method="POST"
          action="/api/quote"
          data-sending={t.contact.sending}
          data-success={t.contact.success}
          data-error={t.contact.error}
        >
          <input type="hidden" name="lang" value={t.htmlLang} />
          <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="grid gap-4 md:grid-cols-2">
            <input required name="name" aria-label={t.contact.name} placeholder={t.contact.name} class="min-h-14 rounded-xl border border-asphalt/50 bg-concrete/60 px-4 text-sm focus:border-asphalt focus:outline-none focus:ring-2 focus:ring-asphalt/20" />
            <input required type="tel" name="phone" aria-label={t.contact.phone} placeholder={t.contact.phone} class="min-h-14 rounded-xl border border-asphalt/50 bg-concrete/60 px-4 text-sm focus:border-asphalt focus:outline-none focus:ring-2 focus:ring-asphalt/20" />
          </div>
          <input type="email" name="email" aria-label={t.contact.email} placeholder={t.contact.email} class="min-h-14 rounded-xl border border-asphalt/50 bg-concrete/60 px-4 text-sm focus:border-asphalt focus:outline-none focus:ring-2 focus:ring-asphalt/20" />
          <select name="service" aria-label={t.contact.service} class="min-h-14 rounded-xl border border-asphalt/50 bg-concrete/60 px-4 text-sm focus:border-asphalt focus:outline-none focus:ring-2 focus:ring-asphalt/20">
            {t.contact.serviceOptions.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
          <textarea name="message" rows="5" aria-label={t.contact.message} placeholder={t.contact.message} class="rounded-xl border border-asphalt/50 bg-concrete/60 px-4 py-4 text-sm focus:border-asphalt focus:outline-none focus:ring-2 focus:ring-asphalt/20"></textarea>
          <button type="submit" class="focus-ring min-h-14 rounded-full bg-signal px-6 text-sm font-extrabold text-asphalt transition hover:bg-signal-500 disabled:cursor-not-allowed disabled:opacity-60">
            {t.contact.send}
          </button>
          <p id="form-status" class="hidden text-center text-sm font-medium" role="status" aria-live="polite"></p>
          <p class="text-center text-[11px] text-asphalt/65">{t.contact.disclaimer}</p>
        </form>
      </div>
    </div>
  </section>
</main>

<!-- ===== Footer ===== -->
