---
import Base from "./Base.astro";
import { site } from "../data/site";

interface Props {
  lang: "en" | "es";
  title: string;
  description: string;
  enHref: string;
  esHref: string;
}
const { lang, title, description, enHref, esHref } = Astro.props;
const isES = lang === "es";
const home = isES ? "/es/" : "/";
const contactHref = isES ? "/es/#contact" : "/#contact";
const telHref = `tel:${site.phoneE164}`;
const toggleHref = isES ? enHref : esHref;
const t = {
  quote: isES ? "Cotización Gratis" : "Free Estimate",
  call: isES ? "Llámanos" : "Call Now",
  toggle: isES ? "English" : "Español",
  back: isES ? "← Volver al inicio" : "← Back to home",
  rights: isES ? "Todos los derechos reservados." : "All rights reserved.",
  ctaTitle: isES ? "¿Listo para tu cotización gratis?" : "Ready for your free estimate?",
  ctaBody: isES
    ? "Atendemos en inglés y español en el área de Chicagoland."
    : "We serve the Chicagoland area in English and Spanish.",
};
---

<Base lang={lang} title={title} description={description} enHref={enHref} esHref={esHref}>
  <header class="sticky top-0 z-50 border-b border-white/10 bg-asphalt-950/95 text-white backdrop-blur-xl">
    <div class="mx-auto flex h-[76px] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <a href={home} class="focus-ring flex min-w-0 items-center rounded-lg" aria-label="Lopez Sealcoating LLC">
        <span class="truncate font-display text-base font-extrabold tracking-[-.03em] sm:text-lg">
          LOPEZ <span class="text-signal">SEALCOATING</span> <span class="font-semibold text-white/45">LLC</span>
        </span>
      </a>
      <div class="flex items-center gap-2 sm:gap-3">
        <a href={toggleHref} class="focus-ring rounded-full border border-signal/55 bg-signal/10 px-3 py-2 text-xs font-extrabold text-signal transition hover:bg-signal hover:text-asphalt sm:px-4">{t.toggle}</a>
        <a href={telHref} class="focus-ring hidden items-center gap-2 rounded-full bg-signal px-4 py-2.5 text-xs font-extrabold text-asphalt transition hover:bg-signal-500 md:inline-flex">{site.phoneDisplay}</a>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- CTA ===== -->
  <section class="asphalt-texture text-white">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 py-14 sm:px-6 lg:flex-row lg:items-center lg:px-8">
      <div>
        <p class="font-display text-2xl font-extrabold sm:text-3xl">{t.ctaTitle}</p>
        <p class="mt-2 text-sm text-white/65">{t.ctaBody}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={contactHref} class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full bg-signal px-6 text-sm font-extrabold text-asphalt transition hover:bg-signal-500">{t.quote}</a>
        <a href={telHref} class="focus-ring inline-flex min-h-12 items-center justify-center rounded-full border border-white/20 px-6 text-sm font-extrabold text-white transition hover:bg-white/10">{t.call} · {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <footer class="bg-asphalt-950 py-10 text-white/60">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <a href={home} class="focus-ring rounded text-sm font-semibold text-white/70 hover:text-signal">{t.back}</a>
      <p class="text-[11px]">© {new Date().getFullYear()} {site.legalName}. {t.rights}</p>
    </div>
  </footer>
</Base>
