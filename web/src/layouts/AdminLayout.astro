---
// Plantilla del panel /admin (en español). No se indexa ni se guarda en caché (src/middleware.ts).
import "../styles/global.css";

interface Props {
  title: string;
  /** Muestra el menú y el botón de salir (no en la pantalla de acceso). */
  nav?: boolean;
}
const { title, nav = true } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} · Panel Lopez Sealcoating</title>
  </head>
  <body class="min-h-screen bg-concrete text-asphalt">
    <header class="border-b border-white/10 bg-asphalt-950 text-white">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <a href="/admin" class="focus-ring flex items-center gap-3 rounded-lg">
          <img src="/brand/emblema-96.webp" alt="" width="40" height="40" class="h-10 w-10" />
          <span class="leading-tight">
            <span class="block font-display text-base font-extrabold">LOPEZ <span class="text-signal">SEALCOATING</span></span>
            <span class="block text-xs font-semibold text-white/60">Panel de administración</span>
          </span>
        </a>
        {nav && (
          <nav class="flex flex-wrap items-center gap-2 text-sm font-bold" aria-label="Panel">
            <a href="/admin" class="focus-ring rounded-full px-3 py-2 text-white/80 hover:bg-white/10 hover:text-white">Secciones</a>
            <a href="/admin/historial" class="focus-ring rounded-full px-3 py-2 text-white/80 hover:bg-white/10 hover:text-white">Historial</a>
            <a href="/" target="_blank" rel="noopener" class="focus-ring rounded-full px-3 py-2 text-white/80 hover:bg-white/10 hover:text-white">Ver sitio ↗</a>
            <form method="post" action="/admin/salir">
              <button type="submit" class="focus-ring rounded-full border border-white/20 px-3 py-2 text-white/80 hover:bg-white/10 hover:text-white">Salir</button>
            </form>
          </nav>
        )}
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>
  </body>
</html>
